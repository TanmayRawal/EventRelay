# ==============================================================================
# EventRelay Environment Configuration Template
# Copy this file to .env and configure environment variables before deployment:
#   cp .env.example .env
# ==============================================================================

# Security & API Authentication
# API key required for mutating endpoints (POST /api/events, DLQ replay, circuit reset)
EVENTRELAY_API_KEY=er_live_secret_key_demo

# Inbound Network & Gateway Configuration
PORT=4000
NODE_ENV=production
CORS_ORIGIN=*
INGESTION_RATE_LIMIT_RPS=200

# PostgreSQL Configuration
POSTGRES_USER=eventrelay
POSTGRES_PASSWORD=replace_with_strong_pg_password
POSTGRES_DB=eventrelay_db
# Composed connection string used by Node.js backend
DATABASE_URL=postgres://eventrelay:replace_with_strong_pg_password@postgres:5432/eventrelay_db

# Redis Configuration (Streams & Token Bucket Rate Limiting)
REDIS_URL=redis://redis:6379
STREAM_NAME=eventrelay:deliveries:stream

# Resilience & Circuit Breaker Tunables
CIRCUIT_THRESHOLD=5
CIRCUIT_COOLDOWN_SECONDS=30
MAX_RETRIES=5
RATE_LIMITER_FAIL_CLOSED=false

# Worker & Scheduler Lifecycle
RUN_WORKER=true
RUN_SCHEDULER=true
